# Copy to .env for local development (docker-compose reads this automatically)

# Postgres connection used by Prisma
# Host ports are 5442/6399 (not the defaults) to avoid clashing with other
# local Postgres/Redis instances; the api container talks to postgres:5432
# and redis:6379 internally regardless. Adjust freely if these are also taken.
DATABASE_URL="postgresql://flags:flags@localhost:5442/feature_flags?schema=public"

# Redis connection for the flag-config cache
REDIS_URL="redis://localhost:6399"

# HMAC pepper used to hash tenant API keys (see src/common/utils/api-key.util.ts)
# Generate a real one with: openssl rand -hex 32
API_KEY_PEPPER="dev-only-pepper-change-me"

PORT=3000
NODE_ENV=development
LOG_LEVEL=debug
